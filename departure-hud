#!/usr/bin/env bash
# departure-hud — launch the Departure HUD as a standalone Wayland surface.
#
# Usage:
#   departure-hud                       # use $XDG_CONFIG_HOME/departure-hud/config.json
#   departure-hud -c PATH               # use the given JSON config
#   departure-hud --config PATH         # same
#   departure-hud --install-config      # copy the sample config into $XDG_CONFIG_HOME
#   departure-hud --print-config        # print the active config path and exit
#
# Any extra args after `--` are forwarded to quickshell.

set -euo pipefail

APP_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
DEFAULT_CONFIG="$XDG_CONFIG_HOME/departure-hud/config.json"
SAMPLE_CONFIG="$APP_DIR/config.json"

config_path="$DEFAULT_CONFIG"
forward_args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -c|--config)
      shift
      [[ $# -gt 0 ]] || { echo "departure-hud: --config needs a path" >&2; exit 2; }
      config_path="$1"; shift
      ;;
    --install-config)
      mkdir -p "$(dirname "$DEFAULT_CONFIG")"
      if [[ -e "$DEFAULT_CONFIG" ]]; then
        echo "departure-hud: $DEFAULT_CONFIG already exists, refusing to overwrite" >&2
        exit 1
      fi
      install -m 0644 "$SAMPLE_CONFIG" "$DEFAULT_CONFIG"
      echo "Installed sample config to $DEFAULT_CONFIG"
      exit 0
      ;;
    --print-config)
      echo "$config_path"
      exit 0
      ;;
    -h|--help)
      sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    --)
      shift; forward_args=("$@"); break
      ;;
    *)
      echo "departure-hud: unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

# If the user has no config yet, fall back to the bundled sample so the app
# is fully runnable straight after installation.
if [[ ! -f "$config_path" ]]; then
  echo "departure-hud: $config_path not found — using bundled defaults" >&2
  config_path="$SAMPLE_CONFIG"
fi

export DEPARTURE_HUD_CONFIG="$config_path"

exec quickshell -p "$APP_DIR/shell.qml" "${forward_args[@]}"
